{
  "name": "dsh-lcm",
  "version": "0.3.0",
  "description": "libre-context-memory DSH adapter: five-arm token reduction (compression, piggyback pruning, observation, static trim, memory) with deterministic distillation, profile injection and warm folding",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/index.js"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "context",
    "compression",
    "spill",
    "libre-context-memory"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.2-rc.1"
    }
  }
}
